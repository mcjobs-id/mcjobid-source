rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDataOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // User Profile canonical collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Sub-collections under users/{uid}
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Clients collection
    match /clients/{clientId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Checklists collection
    match /checklists/{checklistId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Todos collection
    match /todos/{todoId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Rate cards collection
    match /rate_cards/{rateCardId} {
      allow read, update, delete: if isDataOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Testimonials collection - global read, create/update/delete by author
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
